{
  "permissions": {
    "allow": [
      "Bash(ddev describe:*)",
      "Bash(ddev exec php artisan tinker:*)",
      "Bash(ddev exec:*)",
      "Bash(cat:*)",
      "Bash(npm run build:*)",
      "Bash(powershell.exe -ExecutionPolicy Bypass -File .specify/scripts/powershell/check-prerequisites.ps1 -Json -RequireTasks -IncludeTasks)",
      "Bash(git fetch:*)",
      "Bash(sed:*)",
      "Bash(git checkout:*)",
      "Bash(git push:*)",
      "Bash(mkdir:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(php artisan:*)",
      "Bash(npm run types:*)",
      "Bash(npm run format:*)",
      "Bash(./vendor/bin/pint:*)",
      "mcp__laravel-boost__browser-logs",
      "mcp__laravel-boost__last-error"
    ],
    "deny": [],
    "ask": []
  },
  "model": "sonnet 4.5",
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "laravel-boost"
  ]
}
